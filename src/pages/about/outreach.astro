---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
---

<BaseLayout
  title="Outreach - Comet Robotics"
  description="Learn about our community involvement and demographics."
>
  <PageHeader 
    title="Outreach" 
    subtitle="Our community involvement and demographics"
    backgroundImage="/uploads/header/header-bg.avif"
  />
  
  <!-- Outreach Section -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-center mb-4">Coming Soon</h2>
        <p class="text-gray-600 mb-8">
          We're putting together information about our community involvement, outreach programs, and team demographics. Check back soon to see how Comet Robotics is making an impact in our community.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>