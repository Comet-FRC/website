---
import BaseLayout from "../layouts/BaseLayout.astro";
import FrontPage from "../components/Sections/FrontPage.astro";
import FeaturedRobot from "../components/Sections/FeaturedRobot.astro";
import MinimalEvents from "../components/Sections/MinimalEvents.astro";
import MinimalSponsors from "../components/Sections/MinimalSponsors.astro";
---

<!-- Preload the hero image (LCP element) — prefer WebP, fallback JPG -->
<link rel="preload" as="image" href="/uploads/index/hero.webp" fetchpriority="high" type="image/webp">
<link rel="preload" as="image" href="/uploads/index/hero.jpg" fetchpriority="high" type="image/jpeg">

<BaseLayout>
  <FrontPage 
    title="Comet Robotics"
    subtitle="A FIRST® Robotics Team from Haymarket, Virginia"
  />
  
  <!-- Featured Robot Section -->
  <FeaturedRobot />
  
  <!-- Events Section -->
  <MinimalEvents />
  
  <!-- Sponsors Section -->
  <MinimalSponsors />
</BaseLayout>