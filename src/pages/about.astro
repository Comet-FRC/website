---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
import LeadsList from "../components/Sections/LeadsList.astro";
import AboutTabs from "../components/Sections/AboutTabs.astro";
import { Image } from "astro:assets";
import AboutImage from "/public/uploads/about/about.avif";
---

<BaseLayout
  title="About Us - Comet Robotics"
  description="Learn about our teams's history, mission, values, and the people who make our community special."
>
  <PageHeader 
    title="About" 
    subtitle="Our History, Mission, and Values"
    backgroundImage="/uploads/header/about-header.avif"
  />
  
  <!-- About → Vertical Tabs: Who We Are / What We Do / Our Ethos -->
  <section class="py-20 bg-white">
    <div class="container">
      <AboutTabs tabs={[
        {
          id: "who-we-are",
          label: "Who We Are",
          headline: "Who We Are",
          paragraphs: [
            "Comet Robotics is a robotics team based in Haymarket, Virginia. We are a diverse group of passionate students and mentors united by a love for STEM and a drive to make a difference."
          ]
        },
        {
          id: "what-we-do",
          label: "What We Do",
          headline: "What We Do",
          paragraphs: [
            "Each year, we design, build, and program a robot to compete in the FIRST Robotics Competition (FRC). But our mission extends far beyond the competition field.",
            "We engage our community through our annual summer camps, where we teach STEM skills such as coding, manufacturing, and design, and STEM nights, where we showcase our robots at local schools."
          ]
        },
        {
          id: "our-ethos",
          label: "Our Ethos",
          headline: "Our Ethos",
          paragraphs: [
            "We practice gracious professionalism and believe in helping other teams succeed. Whether we're mentoring a rookie team, sharing our CAD designs, or lending parts to a competitor at a competition, we embody the FIRST spirit of Coopertition."
          ],
          quote: {
            text: "We're building a team, not a robot.",
            source: "Comet Robotics Motto"
          }
        }
      ]} />
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="py-16 bg-secondary-100">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <!-- <h2 class="text-secondary-900 text-3xl md:text-4xl font-bold mb-6">Our Motto</h2> -->
          <p class="text-3xl italic font-semibold text-secondary-800 mb-6 border-l-4 border-secondary-500">
            <q>We're building a team, not a robot.</q>
          </p>
          <p class="text-xl text-secondary-800 mb-8">
            At Comet Robotics, our focus isn't just on winning, but on working together and learning together.
          </p>
          <!-- <h2 class="text-3xl md:text-4xl font-bold mb-6">Our Vision</h2>
          <p class="text-xl text-gray-700 mb-8">
            To be a vibrant, growing community of believers who are transformed by the Gospel and transforming our community with the love of Christ.
          </p> -->
        </div>
        
        <div>
          <Image
            loading="lazy"
            src={AboutImage}
            alt="Working in the pits" 
            class="rounded-lg shadow-lg object-cover w-full h-full"
          />
        </div>
      </div>
    </div>
  </section>

  
