  <!-- Leadership Team Preview -->
  <section class="py-16 bg-secondary-100">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Meet Our Team Leads</h2>
        <p class="text-xl text-secondary-800 max-w-3xl mx-auto">
          Our dedicated student leaders
        </p>
      </div>
      
      <!-- Show limited leads preview -->
      <leadsList showAll={false} limit={3} />
      
      <div class="mt-12 text-center">
        <a 
          href="/about/leaders" 
          class="inline-flex items-center justify-center px-5 py-3 text-base font-medium text-white bg-primary-600 rounded-md shadow-sm hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
        >
          Meet All Our Leaders
        </a>
      </div>
    </div>
  </section>
</BaseLayout>