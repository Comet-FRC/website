---
export interface Props {
  title: string;
  description: string;
  image?: {
    url: string;
    alt: string;
  };
  type?: "website" | "article";
  canonicalUrl?: string;
}

const {
  title,
  description,
  image = {
    url: "/favicon.svg",
    alt: "Comet Robotics",
  },
  type = "website",
  canonicalUrl,
} = Astro.props;

// Get the canonical URL
const canonicalURL = canonicalUrl || new URL(Astro.url.pathname, Astro.site);

// Organization info for structured data
const siteUrl = Astro.site?.toString() || "https://comet1885.org/";
const logoUrl = new URL("/favicon.svg", Astro.site).toString();
const orgInfo = {
  name: "Comet Robotics",
  alternateName: "FRC Team 1885",
  description: "A FIRST® Robotics Team from Haymarket, Virginia. FRC Team 1885 competing in the FIRST Robotics Competition.",
  address: {
    streetAddress: "15000 Graduation Drive",
    addressLocality: "Haymarket",
    addressRegion: "VA",
    postalCode: "20169",
    addressCountry: "US",
  },
  email: "comet.1885@gmail.com",
  url: siteUrl,
  logo: logoUrl,
};
---

<!-- Basic SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.url, Astro.site)} />
<meta property="og:image:alt" content={image.alt} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.url, Astro.site)} />
<meta property="twitter:image:alt" content={image.alt} />

<!-- JSON-LD Organization Schema (replaces old Church schema) -->
<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "${orgInfo.name}",
    "alternateName": "${orgInfo.alternateName}",
    "description": "${orgInfo.description}",
    "url": "${orgInfo.url}",
    "logo": "${orgInfo.logo}",
    "email": "${orgInfo.email}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "${orgInfo.address.streetAddress}",
      "addressLocality": "${orgInfo.address.addressLocality}",
      "addressRegion": "${orgInfo.address.addressRegion}",
      "postalCode": "${orgInfo.address.postalCode}",
      "addressCountry": "${orgInfo.address.addressCountry}"
    }
  }
</script>

<!-- BreadcrumbList structured data for navigation context -->
<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "${siteUrl}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "${title.replace(' - Comet Robotics', '').replace(' - Robots - Comet Robotics', '').replace(' - Events - Comet Robotics', '')}",
        "item": "${canonicalURL}"
      }
    ]
  }
</script>

{
  type === "article" && (
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "${title.replace(' - Comet Robotics', '')}",
        "image": "${new URL(image.url, Astro.site)}",
        "description": "${description}",
        "publisher": {
          "@type": "Organization",
          "name": "${orgInfo.name}",
          "logo": {
            "@type": "ImageObject",
            "url": "${orgInfo.logo}"
          }
        },
        "url": "${canonicalURL}",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "${canonicalURL}"
        }
      }
    </script>
  )
}
