---
import Button from "../UI/Button.astro";
import { Image } from "astro:assets";
import heroDesktop from "../../assets/index/hero.webp";

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Comet Robotics",
  subtitle = "A FIRST® Robotics Team from Haymarket, Virginia",
} = Astro.props;
---

<section 
  class="relative min-h-[85vh] flex items-center overflow-hidden"
>
  <!-- Hero background image with responsive variants -->
  <Image
    src={heroDesktop}
    alt="Comet Robotics hero image"
    widths={[640, 768, 1024, 1280, 1536, 1920]}
    sizes="100vw"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/70"></div>
  
  <!-- Subtle gradient overlay for depth -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-900/10 to-transparent pointer-events-none"></div>
  
  <div class="container relative z-10">
    <div class="max-w-3xl">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-4 text-white tracking-tight">
        {title}
      </h1>
      <p class="text-lg md:text-xl mb-8 text-gray-300 tracking-wide uppercase">
        {subtitle}
      </p>
      
      <div class="flex flex-wrap gap-4">
        <Button href="/robots" variant="primary" size="lg">
          Meet Our Robots
        </Button>
      </div>
    </div>
  </div>
  
  <!-- Decorative corner element -->
  <div class="absolute bottom-8 right-8 text-gray-400 text-sm font-mono hidden md:block">
    TEAM 1885
  </div>
</section>