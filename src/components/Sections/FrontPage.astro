---
import Button from "../UI/Button.astro";
import { Image } from "astro:assets";
import heroDesktop from "../../assets/index/hero.webp";
import heroDesktopJpg from "../../assets/index/hero.jpg";
import heroMobile from "../../assets/index/hero-mobile.webp";
import heroMobileJpg from "../../assets/index/hero-mobile.jpg";

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Comet Robotics",
  subtitle = "A FIRST® Robotics Team from Haymarket, Virginia",
} = Astro.props;
---

<section 
  class="relative min-h-[85vh] flex items-center overflow-hidden"
>
  <!-- Hero background image with WebP + responsive picture element -->
  <picture class="absolute inset-0 -z-10">
    <source media="(min-width: 768px)" srcset={heroDesktop.src} type="image/webp">
    <source media="(min-width: 768px)" srcset={heroDesktopJpg.src} type="image/jpeg">
    <source srcset={heroMobile.src} type="image/webp">
    <source srcset={heroMobileJpg.src} type="image/jpeg">
    <Image src={heroDesktop} alt="Comet Robotics hero image" class="w-full h-full object-cover" loading="eager" decoding="async" fetchpriority="high" />
  </picture>
  
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/70"></div>
  
  <!-- Subtle gradient overlay for depth -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-900/10 to-transparent pointer-events-none"></div>
  
  <div class="container relative z-10">
    <div class="max-w-3xl">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-4 text-white tracking-tight">
        {title}
      </h1>
      <p class="text-lg md:text-xl mb-8 text-gray-300 tracking-wide uppercase">
        {subtitle}
      </p>
      
      <div class="flex flex-wrap gap-4">
        <Button href="/robots" variant="primary" size="lg">
          Meet Our Robots
        </Button>
      </div>
    </div>
  </div>
  
  <!-- Decorative corner element -->
  <div class="absolute bottom-8 right-8 text-gray-400 text-sm font-mono hidden md:block">
    TEAM 1885
  </div>
</section>