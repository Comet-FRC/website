---
import Button from "../UI/Button.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
}

const {
  title = "Comet Robotics",
  subtitle = "A FIRST® Robotics Team from Haymarket, Virginia",
  backgroundImage = "/uploads/index/hero.jpg",
} = Astro.props;
---

<section 
  class="relative min-h-[85vh] flex items-center overflow-hidden bg-cover bg-center"
  style={`background-image: linear-gradient(rgba(26, 26, 26, 0.7), rgba(26, 26, 26, 0.7)), url(${backgroundImage});`}
>
  <!-- Subtle gradient overlay for depth -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-900/10 to-transparent pointer-events-none"></div>
  
  <div class="container relative z-10">
    <div class="max-w-3xl">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-4 text-white tracking-tight">
        {title}
      </h1>
      <p class="text-lg md:text-xl mb-8 text-gray-300 tracking-wide uppercase">
        {subtitle}
      </p>
      
      <div class="flex flex-wrap gap-4">
        <Button href="/robots" variant="primary" size="lg">
          Meet Our Robots
        </Button>
      </div>
    </div>
  </div>
  
  <!-- Decorative corner element -->
  <div class="absolute bottom-8 right-8 text-gray-400 text-sm font-mono hidden md:block">
    TEAM 1885
  </div>
</section>
