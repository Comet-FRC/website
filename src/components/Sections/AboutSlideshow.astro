---
import { Image } from "astro:assets";

// Dynamically import all images from the slideshow folder at build time
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/about/slideshow/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

// Filter out low-quality versions and sort by filename
const images = Object.entries(imageModules)
  .filter(([path]) => !path.includes('-low'))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => mod.default);

const numImages = images.length;

// Responsive image configuration
const IMAGE_WIDTHS = [640, 768, 1024, 1280, 1536, 1920];
const IMAGE_SIZES = "(max-width: 768px) 90vw, 75vw";
---

<div
  id="about-slideshow"
  class="slideshow-wrapper"
  style={`height: ${numImages * 100}vh;`}
  data-num-images={numImages}
  role="region"
  aria-label="Image slideshow"
>
  <div class="slideshow-sticky">
    <div class="slideshow-image-container">
      {images.map((img, i) => (
        <div class:list={["slideshow-slide", { active: i === 0 }]} data-index={i}>
          <Image
            src={img}
            alt={`Slideshow image ${i + 1}`}
            widths={IMAGE_WIDTHS}
            sizes={IMAGE_SIZES}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "low"}
            decoding="async"
            class="slideshow-image"
            aria-hidden={i !== 0}
          />
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function initSlideshow() {
    const wrapper = document.getElementById('about-slideshow') as HTMLElement;
    if (!wrapper) return;

    const numImages = parseInt(wrapper.dataset.numImages || '1', 10);
    const slides = wrapper.querySelectorAll('.slideshow-slide') as NodeListOf<HTMLElement>;
    if (!slides.length) return;

    // --- Geometry - computed once on init, recalculated only on resize ---
    let wrapperTop = 0;
    let wrapperHeight = 0;
    let scrollRange = 0;

    function computeGeometry() {
      wrapperTop = wrapper.offsetTop;
      wrapperHeight = wrapper.offsetHeight;
      scrollRange = wrapperHeight - window.innerHeight;
      if (scrollRange < 0) scrollRange = 0;
    }

    computeGeometry();

    // --- State ---
    let currentIndex = 0;
    let accumulatedDelta = 0;
    let resetTimer: ReturnType<typeof setTimeout> | null = null;
    const deltaPerImage = window.innerHeight; // 100vh per image

    function updateIndex() {
      if (scrollRange <= 0) return;

      const scrollY = window.scrollY;
      const offset = scrollY - wrapperTop;
      const progress = Math.max(0, Math.min(1, offset / scrollRange));

      // Apply 0.95 scroll buffer - restrict interpolation to 0-0.95 range
      // This leaves a 5% "unpinning buffer" at the end for smoother exit
      const adjustedProgress = Math.min(progress / 0.95, 1);
      const newIndex = Math.min(Math.floor(adjustedProgress * numImages), numImages - 1);

      // Toggle slideshow-active class on body for navbar styling
      const isActive = scrollY >= wrapperTop && scrollY < wrapperTop + wrapperHeight - window.innerHeight;
      document.body.classList.toggle('slideshow-active', isActive);

      // Only update DOM if index changed
      if (newIndex === currentIndex) return;

      // Switch slides
      slides[currentIndex].classList.remove('active');
      slides[currentIndex].setAttribute('aria-hidden', 'true');
      slides[newIndex].classList.add('active');
      slides[newIndex].setAttribute('aria-hidden', 'false');
      currentIndex = newIndex;
    }

    function onScroll() {
      updateIndex();
    }

    function onWheel(e: WheelEvent) {
      // Only handle wheel events when slideshow is in view
      const scrollY = window.scrollY;
      if (scrollY < wrapperTop - window.innerHeight || scrollY > wrapperTop + wrapperHeight) {
        return;
      }

      // Accumulate delta
      accumulatedDelta += e.deltaY;

      // Calculate new index from accumulated delta
      const newIndex = Math.min(
        Math.max(0, Math.round(accumulatedDelta / deltaPerImage)),
        numImages - 1
      );

      // Update if index changed
      if (newIndex !== currentIndex) {
        slides[currentIndex].classList.remove('active');
        slides[currentIndex].setAttribute('aria-hidden', 'true');
        slides[newIndex].classList.add('active');
        slides[newIndex].setAttribute('aria-hidden', 'false');
        currentIndex = newIndex;

        // Update body class
        const isActive = scrollY >= wrapperTop && scrollY < wrapperTop + wrapperHeight - window.innerHeight;
        document.body.classList.toggle('slideshow-active', isActive);
      }

      // Reset accumulator after scrolling stops
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        accumulatedDelta = currentIndex * deltaPerImage;
      }, 150);
    }

    // --- Resize handler ---
    let resizeTimer: ReturnType<typeof setTimeout> | null = null;

    function onResize() {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        computeGeometry();
        updateIndex();
      }, 100);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('wheel', onWheel, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    updateIndex();
  }

  document.addEventListener('astro:page-load', initSlideshow);
  initSlideshow();
</script>

<style>
  .slideshow-wrapper {
    position: relative;
    width: 100%;
  }

  .slideshow-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    overflow: hidden;
    will-change: transform;
  }

  .slideshow-image-container {
    position: relative;
    width: 75vw;
    max-width: 75vw;
    aspect-ratio: 17 / 9;
    overflow: hidden;
    border-radius: 0.5rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .slideshow-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }

  .slideshow-slide.active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  .slideshow-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>