---
export interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden bg-dark-neutral py-16 md:py-20">
  <!-- Subtle grid pattern -->
  <div class="absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(rgba(78, 62, 120, 0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(78, 62, 120, 0.5) 1px, transparent 1px); background-size: 48px 48px;">
  </div>

  <!-- Top accent line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-500 to-transparent"></div>

  <!-- Bottom accent line -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-500 to-transparent"></div>

  <!-- Corner accents -->
  <div class="absolute top-6 left-6 w-8 h-8 border-t border-l border-primary-500/30 hidden md:block"></div>
  <div class="absolute top-6 right-6 w-8 h-8 border-t border-r border-primary-500/30 hidden md:block"></div>
  <div class="absolute bottom-6 left-6 w-8 h-8 border-b border-l border-primary-500/30 hidden md:block"></div>
  <div class="absolute bottom-6 right-6 w-8 h-8 border-b border-r border-primary-500/30 hidden md:block"></div>

  <div class="container relative z-10">
    <div class="max-w-4xl">
      <!-- Accent dot + line -->
      <div class="flex items-center gap-3 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400"></span>
        <span class="h-px w-12 bg-primary-500/40"></span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight mb-3">
        {title}
      </h1>

      <!-- Subtitle -->
      {subtitle && (
        <p class="text-sm md:text-base text-gray-400 tracking-wide uppercase font-medium max-w-2xl">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>