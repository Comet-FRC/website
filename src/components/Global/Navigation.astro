---
// Define the navigation items
const navItems = [
  { text: "Home", href: "/" },
  { 
    text: "About", 
    href: "/about",
    dropdown: [
      { text: "Leaders", href: "/about/leaders" },
      { text: "Mentors", href: "/about/mentors" },
      { text: "Outreach", href: "/about/outreach" },
    ]
  },
  { text: "Robots", href: "/robots" },
  { text: "Sponsors", href: "/sponsors" },
  { text: "Contact", href: "/contact" },
];

// Get the current URL path to highlight the active link
const currentPath = Astro.url.pathname;
---

<!-- Desktop Navigation -->
<nav id="desktop-nav" class="hidden lg:flex items-center gap-1">
  {navItems.map((item) => {
    const isActive =
      currentPath === item.href ||
      (item.href !== "/" && currentPath.startsWith(item.href));
    const hasDropdown = item.dropdown && item.dropdown.length > 0;
    const isDropdownActive = hasDropdown && item.dropdown!.some(dd => currentPath === dd.href || currentPath.startsWith(dd.href));

    return (
      <div class={`relative ${hasDropdown ? 'group' : ''}`}>
        {hasDropdown ? (
          <>
            <button
              class={`nav-link flex items-center h-9 px-3 text-sm font-medium tracking-wide transition-colors duration-200 rounded-lg ${
                isActive || isDropdownActive
                  ? "text-dark-neutral bg-dark-neutral/5"
                  : "text-dark-neutral/70 hover:text-dark-neutral hover:bg-dark-neutral/[0.03]"
              }`}
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span class="relative">
                {item.text}
                <span class={`absolute -bottom-0.5 left-0 h-[2px] bg-primary transition-all duration-300 ${
                  isActive || isDropdownActive ? "w-full" : "w-0 group-hover:w-full"
                }`} />
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 ml-1.5 transition-transform duration-300 group-hover:rotate-180 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown -->
            <div class="absolute left-0 mt-1.5 w-48 bg-white/80 backdrop-blur-xl rounded-xl border border-dark-neutral/10 shadow-lg shadow-dark-neutral/5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 -translate-y-1 group-hover:translate-y-0 z-50 overflow-hidden">
              <div class="py-1.5">
                <a
                  href={item.href}
                  class={`flex items-center px-3.5 py-2 text-sm font-medium transition-all duration-150 border-l-2 ${
                    currentPath === item.href
                      ? "text-primary border-l-primary bg-primary/5"
                      : "text-dark-neutral/70 border-l-transparent hover:text-dark-neutral hover:bg-dark-neutral/[0.02] hover:border-l-dark-neutral/20"
                  }`}
                >
                  <span class="relative">
                    Overview
                    <span class={`absolute -bottom-0.5 left-0 h-[1.5px] bg-dark-neutral/30 transition-all duration-300 ${
                      currentPath === item.href ? "w-full" : "w-0"
                    }`} />
                  </span>
                </a>
                <div class="h-px bg-dark-neutral/5 mx-3 my-1"></div>
                {item.dropdown.map((dd) => {
                  const isDdActive = currentPath === dd.href;
                  return (
                    <a
                      href={dd.href}
                      class={`flex items-center px-3.5 py-2 text-sm font-medium transition-all duration-150 border-l-2 ${
                        isDdActive
                          ? "text-primary border-l-primary bg-primary/5"
                          : "text-dark-neutral/70 border-l-transparent hover:text-dark-neutral hover:bg-dark-neutral/[0.02] hover:border-l-dark-neutral/20"
                      }`}
                    >
                      <span class="relative">
                        {dd.text}
                        <span class={`absolute -bottom-0.5 left-0 h-[1.5px] bg-dark-neutral/30 transition-all duration-300 ${
                          isDdActive ? "w-full" : "w-0"
                        }`} />
                      </span>
                    </a>
                  );
                })}
              </div>
            </div>
          </>
        ) : (
          <a
            href={item.href}
            class={`nav-link flex items-center h-9 px-3 text-sm font-medium tracking-wide transition-all duration-200 rounded-lg relative ${
              isActive
                ? "text-dark-neutral bg-dark-neutral/5"
                : "text-dark-neutral/70 hover:text-dark-neutral hover:bg-dark-neutral/[0.03]"
            }`}
            aria-current={isActive ? "page" : undefined}
          >
            <span class="relative">
              {item.text}
              <span class={`absolute -bottom-0.5 left-0 h-[2px] bg-primary transition-all duration-300 ${
                isActive ? "w-full" : "w-0 group-hover:w-full"
              }`} />
            </span>
          </a>
        )}
      </div>
    );
  })}

</nav>

<!-- Mobile Menu Button - Animated Hamburger -->
<button
  id="mobile-menu-button"
  class="lg:hidden relative flex flex-col items-center justify-center h-9 w-9 rounded-lg text-dark-neutral hover:bg-dark-neutral/5 transition-all duration-200 focus:outline-none"
  aria-label="Toggle Menu"
  aria-expanded="false"
>
  <span class="hamburger-box relative w-5 h-4">
    <span class="hamburger-line absolute top-0 left-0 w-full h-[2px] bg-dark-neutral rounded-full transition-all duration-300 origin-center"></span>
    <span class="hamburger-line absolute top-1/2 left-0 w-full h-[2px] bg-dark-neutral rounded-full -translate-y-1/2 transition-all duration-300"></span>
    <span class="hamburger-line absolute bottom-0 left-0 w-full h-[2px] bg-dark-neutral rounded-full transition-all duration-300 origin-center"></span>
  </span>
</button>

<!-- Mobile Menu - Full Screen Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 lg:hidden pointer-events-none overflow-x-clip"
  role="menu"
  aria-labelledby="mobile-menu-button"
>
  <!-- Menu Panel -->
  <div id="mobile-panel" class="absolute top-0 right-0 h-full w-80 max-w-[85vw] bg-white translate-x-full transition-transform duration-300 ease-out shadow-2xl">
    <!-- Close button -->
    <div class="flex items-center justify-between h-16 px-6 border-b border-dark-neutral/10 bg-white">
      <span class="text-xs font-bold tracking-[0.15em] uppercase text-dark-neutral/80">Navigation</span>
      <button
        id="mobile-menu-close"
        class="flex items-center justify-center h-9 w-9 rounded-lg text-dark-neutral hover:bg-dark-neutral/10 transition-all duration-200"
        aria-label="Close Menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="px-5 py-6 space-y-1.5 overflow-y-auto max-h-[calc(100vh-4rem)] bg-white">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || 
                           (item.href !== "/" && currentPath.startsWith(item.href));
          const hasDropdown = item.dropdown && item.dropdown.length > 0;
          const isDropdownActive = hasDropdown && item.dropdown!.some(dd => currentPath === dd.href || currentPath.startsWith(dd.href));
          
          return (
            <div class="mobile-nav-item">
              <a
                href={item.href}
                class={`flex items-center px-4 py-3 text-sm font-semibold rounded-lg transition-all duration-150 ${
                  isActive || isDropdownActive
                    ? "bg-primary/10 text-primary"
                    : "text-dark-neutral hover:bg-dark-neutral/10"
                }`}
                role="menuitem"
                aria-current={isActive ? "page" : undefined}
              >
                <span>{item.text}</span>
                {hasDropdown && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                )}
              </a>
              {hasDropdown && (
                <div class="ml-5 mt-1 space-y-0.5 pl-4 border-l-2 border-dark-neutral/20">
                  {item.dropdown!.map((dd) => {
                    const isDdActive = currentPath === dd.href;
                    return (
                      <a
                        href={dd.href}
                        class={`flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg transition-all duration-150 ${
                          isDdActive
                            ? "bg-primary/10 text-primary"
                            : "text-dark-neutral/80 hover:bg-dark-neutral/10 hover:text-dark-neutral"
                        }`}
                        role="menuitem"
                        aria-current={isDdActive ? "page" : undefined}
                      >
                        {dd.text}
                      </a>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })
      }
    </nav>
  </div>
</div>

<style is:global>
  /* ─── Desktop Nav Link Styles ─── */
  .nav-link {
    position: relative;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, transparent 50%, var(--tw-gradient-to, transparent));
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover::before {
    opacity: 1;
  }

  /* ─── Desktop Dropdown ─── */
  .group .absolute {
    transform-origin: top center;
  }

  .group:hover .absolute,
  .group:focus-within .absolute {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }

  .group .absolute a {
    position: relative;
    overflow: hidden;
  }

  .group .absolute a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(78, 62, 120, 0.03), transparent);
    transform: translateX(-100%);
    transition: transform 0.4s ease;
  }

  .group .absolute a:hover::after {
    transform: translateX(100%);
  }

  /* ─── Prevent scroll when mobile menu open ─── */
  body.menu-open {
    overflow: hidden !important;
    overscroll-behavior: none !important;
  }

  /* ─── Mobile Hamburger Animation ─── */
  #mobile-menu-button[aria-expanded="true"] .hamburger-line:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  #mobile-menu-button[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: translateX(100%);
  }

  #mobile-menu-button[aria-expanded="true"] .hamburger-line:nth-child(3) {
    bottom: 50%;
    transform: translateY(50%) rotate(-45deg);
  }

  /* ─── Mobile Menu Open State ─── */
  #mobile-menu.open {
    pointer-events: auto;
  }

  #mobile-menu.open #mobile-panel {
    transform: translateX(0);
  }

  /* ─── Staggered item animation ─── */
  #mobile-menu.open .mobile-nav-item {
    animation: mobileNavSlide 0.3s ease forwards;
    opacity: 0;
  }

  #mobile-menu.open .mobile-nav-item:nth-child(1) { animation-delay: 0.05s; }
  #mobile-menu.open .mobile-nav-item:nth-child(2) { animation-delay: 0.10s; }
  #mobile-menu.open .mobile-nav-item:nth-child(3) { animation-delay: 0.15s; }
  #mobile-menu.open .mobile-nav-item:nth-child(4) { animation-delay: 0.20s; }
  #mobile-menu.open .mobile-nav-item:nth-child(5) { animation-delay: 0.25s; }
  #mobile-menu.open .mobile-nav-item:nth-child(6) { animation-delay: 0.30s; }

  @keyframes mobileNavSlide {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Desktop Underline Animation ─── */
  .nav-link .relative .absolute {
    transition: width 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* ─── Smooth Scrolling for Mobile Menu ─── */
  #mobile-menu nav {
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,0.1) transparent;
  }

  #mobile-menu nav::-webkit-scrollbar {
    width: 4px;
  }

  #mobile-menu nav::-webkit-scrollbar-track {
    background: transparent;
  }

  #mobile-menu nav::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,0.1);
    border-radius: 4px;
  }

  /* ─── Slideshow Active: White logo + hamburger, hide desktop links ─── */
  body.slideshow-active #site-header {
    background: transparent !important;
    border-color: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  body.slideshow-active #site-header a img,
  body.slideshow-active #site-header a svg {
    filter: brightness(0) invert(1);
  }

  body.slideshow-active #desktop-nav {
    display: none !important;
  }

  body.slideshow-active #mobile-menu-button {
    display: flex !important;
    color: white !important;
  }

  body.slideshow-active #mobile-menu-button .hamburger-line {
    background-color: white !important;
  }

  body.slideshow-active #mobile-menu {
    display: block !important;
  }
</style>

<script is:inline>
  // Mobile menu functionality
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    
    let isMenuOpen = false;
    
    const toggleMobileMenu = (open) => {
      isMenuOpen = open !== undefined ? open : !isMenuOpen;
      
      if (isMenuOpen) {
        document.body.classList.add('menu-open');
        if (mobileMenu) mobileMenu.classList.add('open');
        if (mobileMenuButton) mobileMenuButton.setAttribute('aria-expanded', 'true');
      } else {
        document.body.classList.remove('menu-open');
        if (mobileMenu) mobileMenu.classList.remove('open');
        if (mobileMenuButton) mobileMenuButton.setAttribute('aria-expanded', 'false');
      }
    };
    
    // Toggle button
    if (mobileMenuButton) {
      mobileMenuButton.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMobileMenu();
      });
    }
    
    // Close button
    if (mobileMenuClose) {
      mobileMenuClose.addEventListener('click', () => {
        toggleMobileMenu(false);
      });
    }
    
    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen) {
        toggleMobileMenu(false);
      }
    });
    
    // Close on nav link click
    const navLinks = mobileMenu && mobileMenu.querySelectorAll('nav a[href^="/"]');
    if (navLinks) {
      navLinks.forEach(link => {
        link.addEventListener('click', () => {
          if (isMenuOpen) {
            setTimeout(() => toggleMobileMenu(false), 100);
          }
        });
      });
    }
    
    // Handle window resize
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isMenuOpen) {
        toggleMobileMenu(false);
      }
    });

    // ─── Desktop Dropdown Accessibility ───
    const dropdownTriggers = document.querySelectorAll('.group button[aria-haspopup="true"]');
    
    dropdownTriggers.forEach(trigger => {
      const parent = trigger.closest('.group');
      const dropdown = parent && parent.querySelector('.group-hover\\:opacity-100');
      
      if (!dropdown) return;

      function openDropdown() {
        dropdown.classList.remove('opacity-0', 'invisible');
        dropdown.classList.add('opacity-100', 'visible');
      }

      function closeDropdown() {
        dropdown.classList.remove('opacity-100', 'visible');
        dropdown.classList.add('opacity-0', 'invisible');
      }
      
      trigger.addEventListener('focus', openDropdown);
      
      trigger.addEventListener('blur', () => {
        setTimeout(() => {
          if (dropdown && !dropdown.contains(document.activeElement) && document.activeElement !== trigger) {
            closeDropdown();
          }
        }, 150);
      });

      trigger.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeDropdown();
          trigger.focus();
        }
      });
    });

    // Keep dropdown open on item focus
    document.querySelectorAll('.group .absolute a').forEach(link => {
      const parent = link.closest('.group');
      const dropdown = parent && parent.querySelector('.group-hover\\:opacity-100');
      const trigger = parent && parent.querySelector('button[aria-haspopup="true"]');
      
      if (!dropdown || !trigger) return;

      link.addEventListener('focus', () => {
        dropdown.classList.remove('opacity-0', 'invisible');
        dropdown.classList.add('opacity-100', 'visible');
      });
      
      link.addEventListener('blur', () => {
        setTimeout(() => {
          if (dropdown && !dropdown.contains(document.activeElement) && document.activeElement !== trigger) {
            dropdown.classList.remove('opacity-100', 'visible');
            dropdown.classList.add('opacity-0', 'invisible');
          }
        }, 150);
      });

      // Close on Escape from dropdown items
      link.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          dropdown.classList.remove('opacity-100', 'visible');
          dropdown.classList.add('opacity-0', 'invisible');
          trigger.focus();
        }
      });
    });
  });

</script>
