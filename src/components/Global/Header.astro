---
import Navigation from "./Navigation.astro";
import Logo from "../../assets/logo/comet_cat.svg"
---

<header id="site-header" class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-xl border-b border-dark-neutral/5 transition-all duration-300">
  <div class="container flex items-center justify-between h-16">
    <a href="/" class="flex items-center text-dark-neutral transition-opacity duration-200 hover:opacity-70">
      <span class="sr-only">Comet Robotics Home</span>
      <Logo class="w-24 h-auto" />
    </a>
    
    <Navigation />
  </div>
</header>