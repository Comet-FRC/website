---
import "../assets/styles/global.css";
import Seo from "../components/UI/Seo.astro";
import Header from "../components/Global/Header.astro";
import Footer from "../components/Global/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: {
    url: string;
    alt: string;
  };
  type?: "website" | "article";
  canonicalUrl?: string;
}

const {
  title = "Comet Robotics - Home",
  description = "We are a robotics team with a passion for innovation and community.",
  image = {
    url: "/favicon.svg",
    alt: "Comet Robotics",
  },
  type = "website",
  canonicalUrl,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preconnect to self for faster asset loading -->
    <link rel="preconnect" href="https://comet1885.org" crossorigin>
    
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      canonicalUrl={canonicalUrl}
    />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    
    <!-- Critical CSS inlined for above-the-fold content -->
    <style is:inline>
      /* Critical: Header, Hero, Slideshow container */
      .flex.flex-col.min-h-screen { display: flex; flex-direction: column; min-height: 100vh; }
      header.sticky { position: sticky; top: 0; z-index: 50; }
      .container { width: 100%; max-width: 80rem; margin: 0 auto; padding: 0 1rem; }
      @media (min-width: 640px) { .container { padding: 0 1.5rem; } }
      @media (min-width: 1024px) { .container { padding: 0 2rem; } }
      
      /* Slideshow critical styles */
      .slideshow-wrapper { position: relative; width: 100%; }
      .slideshow-sticky { position: sticky; top: 0; height: 100vh; width: 100%; display: flex; align-items: center; justify-content: center; background: #111; overflow: hidden; }
      .slideshow-image-container { position: relative; width: 75vw; max-width: 75vw; aspect-ratio: 17 / 9; overflow: hidden; border-radius: 0.5rem; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4); }
      .slideshow-slide { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; z-index: 0; pointer-events: none; }
      .slideshow-slide.active { opacity: 1; z-index: 1; pointer-events: auto; }
      .slideshow-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
      
      /* Hero critical styles */
      .relative.min-h-\[85vh\] { position: relative; min-height: 85vh; display: flex; align-items: center; overflow: hidden; }
      .absolute.inset-0.-z-10 { position: absolute; inset: 0; z-index: -10; width: 100%; height: 100%; object-fit: cover; }
      
      /* Typography critical */
      h1, h2, h3, h4, h5, h6 { font-family: 'Playfair Display', serif; font-weight: 700; }
      body { font-family: 'Source Sans Pro', system-ui, sans-serif; }
    </style>
    
    <!-- Defer non-critical CSS (Tailwind utilities, components) -->
    <link rel="preload" as="style" href="/_astro/global.css" onload="this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/_astro/global.css"></noscript>
    
    <!-- Prevent browser scroll restoration and scroll anchoring (deferred) -->
    <script is:inline defer>
      if (history.scrollRestoration) {
        history.scrollRestoration = 'manual';
      }
      // Disable scroll anchoring to prevent the browser from auto-adjusting
      // scroll position when images/content load after paint
      document.documentElement.style.overflowAnchor = 'none';
      // Scroll to top on initial page load and bfcache restore
      window.scrollTo(0, 0);
      requestAnimationFrame(() => window.scrollTo(0, 0));
      window.addEventListener('pageshow', () => {
        window.scrollTo(0, 0);
      });
    </script>
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <Header />
      
      <main class="flex-grow">
        <slot />
      </main>
      
      <Footer />
    </div>
    
  </body>
</html>
